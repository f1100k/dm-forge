# ───────────────────────────────────────────────────────────────────────────
# dm-forge — variáveis de ambiente
# Copie este arquivo para `.env` e preencha. Segredos NUNCA vão para o repo.
# ───────────────────────────────────────────────────────────────────────────

# Modo de execução. Aceita: development | test | production.
NODE_ENV=development

# ─── Banco de dados ────────────────────────────────────────────────────────
# Credenciais consumidas pelo docker-compose E expandidas em DATABASE_URL.
# Mantenha um único lugar de verdade: muda aqui, replica em todo lado.
POSTGRES_USER=dmforge
POSTGRES_PASSWORD=dmforge
POSTGRES_DB=dmforge
POSTGRES_PORT=5432

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# ─── apps/api ──────────────────────────────────────────────────────────────
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Better Auth: segredo de assinatura de sessão (>= 32 caracteres).
# Gere com: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Chave-mestra AES-256-GCM para criptografar BYOK (32 bytes em base64).
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=

# Salt do hash (IP + e-mail) do contador de brute-force do login (>= 32 chars).
# IP e e-mail nunca são persistidos em claro (LGPD). Trocar o salt só zera as
# janelas de bloqueio em andamento. Gere com: openssl rand -base64 32
IP_HASH_SALT=

# Chave compartilhada do endpoint de suporte que restaura contas em exclusão
# pendente (POST /api/internal/account/:id/restore, ADR 0009). Opcional: sem
# ela o endpoint fica fechado. Gere com: openssl rand -base64 32
SUPPORT_API_KEY=

# ─── E-mail transacional (ADR 0007) ────────────────────────────────────────
# Provider de envio de e-mails de autenticação (verificação, reset, etc.).
# Aceita: noop | resend. Use `noop` em dev/test (loga só o tipo, não envia).
EMAIL_PROVIDER=noop

# Obrigatórios quando EMAIL_PROVIDER=resend. Boot falha se faltarem.
# API key: https://resend.com/api-keys  |  Remetente de domínio verificado.
RESEND_API_KEY=
EMAIL_FROM=DM Forge <no-reply@dmforge.app>

# ─── OAuth social (ADR 0003, card S1.1) ────────────────────────────────────
# Login com Google (único provider social do produto). Só é registrado quando
# o par id+secret está presente — deixe em branco para desabilitar em dev.
# Google:  https://console.cloud.google.com/apis/credentials
# Callback: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── apps/web ──────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000

# ─── Integrações com agentes (MCP) ─────────────────────────────────────────
# Estas variáveis alimentam os MCP servers configurados em .ai/mcp.json.
NOTION_TOKEN=
CONTEXT7_API_KEY=

# GitHub NÃO é MCP: toda operação (PR, issue, review) usa a CLI `gh`, que se
# autentica sozinha (`gh auth login`). Este token é opcional e serve apenas aos
# scripts de devex que aceitam PAT como alternativa ao `gh` — veja
# docs/devex/secret-scanning.md.
GITHUB_PERSONAL_ACCESS_TOKEN=
